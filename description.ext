// REQUIRED ITEMS
enableDebugConsole = 1;
respawnOnStart = -1;

// MISSION DETAILS
class Header
{
    gameType   = COOP;
    minPlayers = 1;
    maxPlayers = 71; // Including Zeus Slots
};

// MISSION NAME
onLoadName    = "COOP ## Mission Template";
onLoadMission = "";
author        = "Scofer";
loadScreen = "";

// RESPAWN - Leave as is, unless important to change.
respawn = "BASE";
respawnTemplates[] = {"ace_spectator","BASE"};
respawnDelay = 999999;

// GARBAGE COLLECTOR
corpseManagerMode = 1;
corpseLimit = 20;
corpseRemovalMinTime = 30;
corpseRemovalMaxTime = 300;
wreckLimit = 15;
wreckRemovalMinTime = 60;
wreckRemovalMaxTime = 300;
minPlayerDistance = 0;

